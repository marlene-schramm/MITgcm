# ====================
# | Runtime parameters for the package OBCS |
# ====================
#
 &OBCS_PARM01
# activate northern and southern open boundaries
 OB_singleJnorth = -1,
 OB_singleJsouth = 1,

# allow prescribed boundaries from files
 useOBCSprescribe = .TRUE.,
# specify boundary files (north/south and temperature/salinity)
 OBNtFile = 'boundary_pt_noSC_MEOP_2008-07-16_08:00_Nx50_Nz50_Nt72.bin',
 OBStFile = 'boundary_pt_noSC_MEOP_2008-07-16_08:00_Nx50_Nz50_Nt72.bin',
 OBNsFile = 'boundary_SA_MEOP_2008-07-16_08:00_Nx50_Nz50_Nt36.bin',
 OBSsFile = 'boundary_SA_MEOP_2008-07-16_08:00_Nx50_Nz50_Nt36.bin',

# allow Orlanski radiation
# useOrlanskiNorth = .TRUE.,
# useOrlanskiSouth = .TRUE.,

# useOBCSbalance = .FALSE.,
 &